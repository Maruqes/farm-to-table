# Docker Compose variables. Copy to .env (never commit .env).
JWT_SECRET=change-me
# Generate: docker run --rm php:8.4-cli-alpine php -r 'echo "base64:".base64_encode(random_bytes(32)),"\n";'
BACKOFFICE_APP_KEY=
# Silo (MinIO-compatible S3, runs in compose). These are also the Silo root credentials: set a long random secret.
S3_BUCKET=farm-to-table
S3_ACCESS_KEY=farm
S3_SECRET_KEY=

# API: number of trusted reverse-proxy hops (compose sets 1 for the web/nginx proxy).
# Leave unset when calling the API directly; otherwise a client could spoof X-Forwarded-For.
# TRUST_PROXY=1

# Web: true serves local fixtures; false (default) talks to the real API through /api.
# Read from this file by Vite (envDir points at the repo root).
VITE_USE_MOCKS=false

# Seed script passwords (dev only, never commit real values).
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
