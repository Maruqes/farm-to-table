// Deploys on the cluster node itself over SSH: wait for images, pull, check .env, apply infra/k8s, check.
// Images are built and pushed by .github/workflows/images.yml, not here.
// Jenkins job: Pipeline from SCM, Script Path = infra/jenkins/Jenkinsfile. Needs sshpass on the Jenkins agent.
// The node needs git and kubectl, and a populated .env in the project folder.

// Runs one command on the node, inside the project folder. Commands must not contain single quotes.
def remote(String cmd) {
  // sshpass -e reads the password from the SSHPASS variable, so it never appears in the command line or the log.
  withCredentials([usernamePassword(credentialsId: 'd28eafc4-23e5-431d-bd07-1b921e2b5616', usernameVariable: 'SSH_USER', passwordVariable: 'SSHPASS')]) {
    sh "sshpass -e ssh -o StrictHostKeyChecking=accept-new \$SSH_USER@marques2673sv.machine 'cd /home/marques2673sv/farm-to-table && ${cmd}'"
  }
}

pipeline {
  agent any

  // Check GitHub for new commits every 2 minutes (Jenkins asks GitHub, so GitHub never has to reach Jenkins).
  triggers { pollSCM('H/2 * * * *') }

  stages {
    stage('Wait for images') {
      // Wait until .github/workflows/images.yml has pushed the images for this commit (up to 20 minutes).
      steps {
        sh '''
          for i in $(seq 40); do
            r=$(curl -fsS "https://api.github.com/repos/Maruqes/farm-to-table/actions/workflows/images.yml/runs?head_sha=$GIT_COMMIT&per_page=1" | tr -d ' \n')
            case "$r" in
              *'"conclusion":"success"'*) exit 0 ;;
              *'"conclusion":"failure"'*|*'"conclusion":"cancelled"'*) echo "Image build failed on GitHub"; exit 1 ;;
            esac
            sleep 30
          done
          echo "Timed out waiting for the image build"; exit 1
        '''
      }
    }

    stage('Pull') {
      steps { script { remote('git pull --ff-only') } }
    }

    stage('Check .env') {
      // No .env on the node: stop here, before anything is built or changed.
      steps { script { remote('test -s .env') } }
    }

    stage('Apply') {
      steps {
        script {
          // The namespace must exist before the Secret can be created in it.
          remote('kubectl apply -f infra/k8s/00-namespace.yaml')
          // Create or update the Secret from .env.
          remote('kubectl -n farm-to-table create secret generic farm-to-table --from-env-file=.env --dry-run=client -o yaml | kubectl -n farm-to-table apply -f -')
          // silo-init is a finished Job; its spec is immutable, so recreate it instead of applying over it.
          remote('kubectl -n farm-to-table delete job silo-init --ignore-not-found')
          // Apply a rendered copy: the two public ports come from .env (defaults 30080 / 30081 stay if unset).
          remote('W=$(grep ^K8S_WEB_PORT= .env | cut -d= -f2); B=$(grep ^K8S_BACKOFFICE_PORT= .env | cut -d= -f2); D=$(mktemp -d) && cp infra/k8s/*.yaml $D/ && sed -i "s/nodePort: 30080/nodePort: ${W:-30080}/; s/nodePort: 30081/nodePort: ${B:-30081}/" $D/*.yaml && kubectl -n farm-to-table apply -f $D/ && rm -rf $D')
          // The tag is always "latest", so apply alone would not pick up the new images.
          remote('kubectl -n farm-to-table rollout restart deployment/api deployment/web deployment/backoffice')
        }
      }
    }

    stage('Check') {
      steps {
        script {
          remote('for s in api web backoffice; do kubectl -n farm-to-table rollout status deployment/$s --timeout=180s || exit 1; done')
          remote('kubectl -n farm-to-table get pods')
        }
      }
    }
  }

  post {
    // Show why a rollout is stuck: pod states, nodes, and the latest cluster events.
    failure {
      script { remote('kubectl -n farm-to-table get pods -o wide; kubectl -n farm-to-table get events --sort-by=.lastTimestamp | tail -n 30') }
    }
  }
}
